// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id            String    @id @default(uuid())  // C-1: DB-generated UUID
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  rmas          Rma[]
  
  @@map("customers")
}

model Rma {
  id              String          @id               // RMA-XXXXXX short code, still generated in repo
  customerId      String?
  customerName    String?         // Preserved customer name for deleted customers
  customerEmail   String?         // Preserved customer email
  customerPhone   String?         // Preserved customer phone
  creationDate    DateTime        @default(now())   // A-2: was String
  lastUpdateDate  DateTime        @default(now()) @updatedAt  // A-2: was String
  dateOfIncident  String          // Date-only (YYYY-MM-DD) — kept as String intentionally
  dateOfReport    String          // Date-only (YYYY-MM-DD) — kept as String intentionally
  attachment      String?
  isInjuryRelated Boolean         @default(false)
  injuryDetails   String?
  
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  devices         RmaDevice[]
  serviceCycles   ServiceCycle[]
  
  @@index([customerId], name: "idx_rmas_customerId")
  @@index([creationDate], name: "idx_rmas_creationDate")
  @@map("rmas")
}

model RmaDevice {
  id            Int     @id @default(autoincrement())
  rmaId         String
  articleNumber String?
  serialNumber  String
  quantity      Int?
  
  rma           Rma     @relation(fields: [rmaId], references: [id], onDelete: Cascade)
  
  @@unique([serialNumber, rmaId])
  @@index([rmaId], name: "idx_rma_devices_rmaId")
  @@index([serialNumber], name: "idx_rma_devices_serialNumber")
  @@map("rma_devices")
}

model ServiceCycle {
  id                  Int               @id @default(autoincrement())
  rmaId               String
  deviceSerialNumber  String
  status              String
  creationDate        DateTime          @default(now())   // A-2: was String
  statusDate          DateTime          @default(now())   // A-2: was String
  issueDescription    String?
  accessoriesIncluded String?
  
  rma                 Rma               @relation(fields: [rmaId], references: [id], onDelete: Cascade)
  history             ServiceHistory[]
  testReport          TestReport?
  
  @@index([rmaId], name: "idx_service_cycles_rmaId")
  @@index([deviceSerialNumber], name: "idx_service_cycles_deviceSerialNumber")
  @@map("service_cycles")
}

model ServiceHistory {
  id              Int           @id @default(autoincrement())
  serviceCycleId  Int
  status          String
  date            DateTime      @default(now())   // A-2: was String
  notes           String?
  
  serviceCycle    ServiceCycle  @relation(fields: [serviceCycleId], references: [id], onDelete: Cascade)
  
  @@index([serviceCycleId], name: "idx_service_history_serviceCycleId")
  @@map("service_history")
}

model TestReport {
  id                String        @id @default(uuid())
  serviceCycleId    Int           @unique
  testDate          DateTime      @default(now())
  deviceType        String
  manufacturer      String
  performedBy       String
  testerName        String
  kindOfTest        String
  equipmentUsed     Json          // Array of { id: string, name: string }
  testSteps         Json          // Array of { stepNo: number, name: string, criterion: string, unit: string, result: string, isOk: boolean }
  overallAssessment String?
  overallResult     String        // e.g. "Passed" or "Failed"
  copyPrintedBy     String?
  reportNo          String?
  
  serviceCycle      ServiceCycle  @relation(fields: [serviceCycleId], references: [id], onDelete: Cascade)

  @@index([serviceCycleId], name: "idx_test_reports_serviceCycleId")
  @@map("test_reports")
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  password         String   // Hashed
  name             String
  role             String   @default("MANAGER") // "MANAGER", "COORDINATOR", "SERVICE_ENGINEER"
  isAdmin          Boolean  @default(false)
  isActive         Boolean  @default(true)
  isDeleted        Boolean  @default(false)
  lastLoginAt      DateTime?
  resetToken       String?
  resetTokenExpiry DateTime?
  signatureUrl     String?  // Optional path to the user's uploaded signature image
  updatedAt        DateTime @updatedAt
  auditLogs        AuditLog[]

  @@map("users")
}

model Notification {
  id          String   @id @default(uuid())
  type        String   // 'PASSWORD_RESET_REQUEST', 'SYSTEM_ALERT', etc.
  message     String
  metadata    String?  // JSON string for additional data
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // e.g., "LOGIN", "CREATE_RMA", "UPDATE_STATUS"
  entity    String   // e.g., "RMA", "USER", "CUSTOMER"
  entityId  String?  // ID of the affected entity
  details   String?  // Additional context or JSON data
  ipAddress String?
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_audit_userId")
  @@index([action], name: "idx_audit_action")
  @@map("audit_logs")
}

model Article {
  id        String   @id @default(uuid())
  articleNo String   @unique
  name      String?
  createdAt DateTime @default(now())

  @@map("articles")
}

model TestStepTemplate {
  id         String   @id @default(uuid())
  articleNo  String
  stepNo     Int
  name       String
  question   String?
  criterion  String?
  createdAt  DateTime @default(now())

  @@index([articleNo])
  @@map("test_step_templates")
}

model TestEquipmentTemplate {
  id          String   @id @default(uuid())
  equipmentId String
  name        String
  createdAt   DateTime @default(now())

  @@map("test_equipment_templates")
}
